{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // account_id and database_id are identifiers, not API tokens. Secrets stay in .dev.vars / wrangler secret.
  "name": "forge-worker-editor",
  "main": "src/index.ts",
  "account_id": "a24ce30584273b42333051f1cdec48e2",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "a24ce30584273b42333051f1cdec48e2"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // SPA fallback swallows iframe navigations unless the Worker runs first.
    "run_worker_first": ["/api/*", "/preview/*"]
  },
  "d1_databases": [
    {
      "binding": "DB_PROJECTS",
      "database_name": "forge-d1-projects",
      "database_id": "01d0822e-2dc8-49a2-b9e5-052a07b46985"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_ASSETS",
      "bucket_name": "forge-r2-assets"
    }
  ]
}
